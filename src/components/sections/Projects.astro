---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { websites, repos } from '../../data/projects';
import { site } from '../../data/site';
---

<section id="projets" class="section" aria-labelledby="t-proj">
  <div class="container-page flex flex-col gap-11">
    <h2 id="t-proj" class="section-title">Projets</h2>

    <div class="flex flex-col gap-4">
      <h3 class="eyebrow">Sites en ligne</h3>
      <div class="grid gap-7 md:grid-cols-2">
        {
          websites.map((w) => (
            <a class="card reveal" href={w.url} target="_blank" rel="noopener">
              <Photo
                src={w.image}
                alt={w.imageAlt}
                ratio="16 / 10"
                sizes="(min-width: 1024px) 540px, (min-width: 768px) 45vw, 100vw"
                position={w.imagePosition}
                background={w.imageBg}
              />
              <h4 class="m-0 mt-1.5 text-[19px] font-bold">{w.name} ↗</h4>
              <p class="m-0 text-[15px] text-muted">{w.description}</p>
              {w.tags && (
                <div class="flex flex-wrap gap-1.5">
                  {w.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col">
      <div class="mb-2.5 flex flex-wrap items-baseline justify-between gap-4">
        <h3 class="eyebrow">Sur GitHub</h3>
        <a href={site.github} target="_blank" rel="noopener" class="text-sm">Voir le profil ↗</a>
      </div>
      {
        repos.map((r) => (
          <a
            class="reveal grid min-h-11 grid-cols-[22px_minmax(0,1fr)_auto_16px] items-center gap-3.5 border-t border-line px-2 py-3.5 no-underline transition-shadow duration-150 hover:text-fg hover:shadow-[inset_3px_0_0_var(--accent)]"
            href={r.url}
            target="_blank"
            rel="noopener"
          >
            <Icon name="github" size={18} />
            <span class="flex min-w-0 flex-col">
              <span class="font-bold">{r.name}</span>
              <span class="text-sm text-muted">{r.description}</span>
            </span>
            <span class="tag">{r.lang}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
