---
import { career } from '../../data/career';
---

<section id="parcours" class="section" aria-labelledby="t-path">
  <div class="container-page flex flex-col gap-7">
    <h2 id="t-path" class="section-title">Parcours</h2>
    <ol class="m-0 list-none border-b border-line p-0">
      {
        career.map((step) => (
          <li class="reveal grid grid-cols-1 gap-2.5 border-t border-line py-6.5 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-5">
            <span class="self-start border-l-3 border-accent pl-2.5 text-sm font-bold whitespace-nowrap">
              {step.period}
            </span>
            <div class="flex flex-col gap-2.5">
              <h3 class="m-0 text-xl font-bold">{step.title}</h3>
              <span class="text-[13px] text-muted">{step.subtitle}</span>
              {step.description && <p class="m-0 text-muted">{step.description}</p>}
              {step.tags && (
                <div class="flex flex-wrap gap-1.5">
                  {step.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              )}
              {step.projects && (
                <div class="flex flex-col">
                  {step.projects.map((p) => (
                    <div class="flex flex-col gap-1.5 border-b border-line py-3 last:border-b-0">
                      <span>{p.name}</span>
                      <div class="flex flex-wrap gap-1.5">
                        {p.tags.map((t) => <span class="tag">{t}</span>)}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
