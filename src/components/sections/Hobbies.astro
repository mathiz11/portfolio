---
import Icon from '../Icon.astro';
import { hobbies } from '../../data/hobbies';
---

<section id="hobbies" class="section" aria-labelledby="t-hob">
  <div class="container-page flex flex-col gap-9">
    <h2 id="t-hob" class="section-title">Hobbies</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        hobbies.map((h) => (
          <div class="box reveal">
            <Icon name={h.icon} size={28} strokeWidth={1.5} />
            <h3 class="m-0 text-lg font-bold">{h.title}</h3>
            <p class="m-0 text-[15px] text-muted">{h.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
