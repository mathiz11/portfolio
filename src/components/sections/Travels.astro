---
import Photo from '../Photo.astro';
import { travels } from '../../data/travels';
import { site } from '../../data/site';

// Regroupe les voyages par année, la plus récente en premier
const years = [...new Set(travels.map((t) => t.year))].sort((a, b) => b - a);
const groups = years.map((year) => ({ year, items: travels.filter((t) => t.year === year) }));
---

<section id="voyages" class="section min-h-dvh" aria-labelledby="t-trav">
  <div class="container-page flex flex-col gap-11">
    <h2 id="t-trav" class="section-title">Voyages</h2>

    {
      groups.map((g) => (
        <div class="flex flex-col gap-4.5">
          <div class="flex items-center gap-3.5">
            <h3 class="m-0 text-[22px] font-bold">{g.year}</h3>
            <span class="h-px flex-1 bg-line" />
          </div>
          <div class="photo-scroller sm:grid-cols-2 sm:gap-x-4 sm:gap-y-6 lg:grid-cols-3 lg:gap-x-6">
            {g.items.map((t) => (
              <article class="card reveal">
                <Photo src={t.image} alt={t.imageAlt} ratio="3 / 4" sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 80vw" />
                <span class="mt-1 text-[13px] font-bold text-muted">
                  {t.month}
                  {t.type && ` · ${t.type}`}
                </span>
                <h4 class="m-0 text-lg font-bold">{t.title}</h4>
                {t.meta && <span class="text-sm text-muted">{t.meta}</span>}
              </article>
            ))}
          </div>
        </div>
      ))
    }

    <footer class="mt-10 flex justify-between gap-4 border-t border-line pt-4 text-[13px] text-muted">
      <span>{site.name} · {new Date().getFullYear()}</span>
      <a href={site.github} target="_blank" rel="noopener" class="text-muted hover:text-fg">GitHub ↗</a>
    </footer>
  </div>
</section>
