---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Ratio CSS, ex. « 4 / 3 » */
  ratio?: string;
  /** Attribut sizes : largeur affichée selon l'écran (le navigateur choisit la bonne taille, écrans Retina compris) */
  sizes?: string;
  widths?: number[];
  position?: string;
  background?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  sizes = '(min-width: 1024px) 360px, 50vw',
  widths = [640, 1000, 1600],
  position = 'center',
  background,
  eager = false,
  class: className,
} = Astro.props;

// Garde les tailles plus petites que l'original, et ajoute l'original si besoin
const usable = widths.filter((w) => w < src.width);
const finalWidths = usable.length && usable.at(-1)! < src.width * 0.9 ? [...usable, src.width] : usable.length ? usable : [src.width];
---

<div class:list={['frame', className]} style={{ aspectRatio: ratio, background }}>
  <Picture
    src={src}
    alt={alt}
    formats={['webp']}
    widths={finalWidths}
    sizes={sizes}
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={{ objectPosition: position }}
    pictureAttributes={{ class: 'block h-full w-full' }}
  />
</div>
